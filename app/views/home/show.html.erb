<% content_for :title, "Storyloop" %>
<header class="mb-6">
  <p class="font-serif text-3xl font-semibold text-ink-strong">Storyloop</p>
  <p class="text-muted mt-1"><%= t("home.tagline") %></p>
</header>

<% if @reader %>
  <section class="grid gap-3 mb-8">
    <div class="card p-5 flex items-center justify-between gap-4">
      <p class="font-semibold text-ink-strong" id="due-today"><%= t("home.due_today", count: @due_today) %></p>
      <% if @due_today.positive? %><%= link_to t("home.review"), review_path, class: "btn-primary shrink-0" %><% end %>
    </div>

    <% if @continue %>
      <% episode = @continue[:episode] %>
      <%= link_to episode_path(episode), class: "card p-5 block hover:border-ink-strong transition-colors", id: "continue-reading" do %>
        <p class="label"><%= @continue[:next] ? t("home.next_up") : t("home.continue") %></p>
        <p class="font-serif text-xl font-semibold text-ink-strong"><%= episode.series.title %> · <%= episode.number %>. <%= episode.title %></p>
        <% unless @continue[:next] %>
          <div class="mt-3 h-1.5 rounded-full bg-recess overflow-hidden" aria-hidden="true">
            <div class="h-full bg-ink-strong" style="width: <%= (100.0 * @continue[:done] / [ @continue[:total], 1 ].max).round %>%"></div>
          </div>
          <p class="text-xs text-muted mt-1 tabular-nums"><%= t("home.panel_progress", done: @continue[:done], total: @continue[:total]) %></p>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% end %>

<% @pairs.sort_by { |pair| pair.id == @reader&.language_pair_id ? 0 : 1 }.each do |pair| %>
  <% series_list = pair.series.select(&:published?).sort_by { |s| [ s.position, s.id ] } %>
  <% next if series_list.empty? %>
  <section class="mb-8">
    <h2 class="label"><%= pair.code %></h2>
    <div class="grid gap-3">
      <% series_list.each do |series| %>
        <article class="card p-5">
          <h3 class="font-serif text-2xl font-semibold text-ink-strong"><%= series.title %></h3>
          <p class="text-sm text-muted mt-0.5"><%= series.cefr_level %> · <%= series.genre %></p>
          <p class="mt-2"><%= series.description %></p>
          <ol class="mt-4 grid gap-1 text-sm">
            <% series.episodes.select(&:published?).each do |episode| %>
              <li>
                <%= link_to episode_path(episode), class: "flex min-h-10 items-center gap-2 rounded-lg -mx-2 px-2 hover:bg-recess" do %>
                  <span class="tabular-nums text-muted w-5"><%= episode.number %></span>
                  <span class="text-ink-strong min-w-0 truncate"><%= episode.title %></span>
                  <span class="ml-auto shrink-0 text-xs text-muted">
                    <% if @progress&.dig(episode.id)&.completed? %>✓ <%= t("home.completed") %><% elsif !episode.free? %>🔒<% end %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ol>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
