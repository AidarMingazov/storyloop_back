<%# Live generation status; replaced over Turbo Streams by StoryRequest#broadcast_status. %>
<% episode = story_request.episode %>
<div id="<%= dom_id(story_request, :status) %>" class="card p-5" data-status="<%= story_request.status %>">
  <% if story_request.succeeded? && episode.published? %>
    <p class="font-semibold text-ink-strong text-lg"><%= t("stories.status_page.ready") %></p>
    <div class="mt-3 flex flex-wrap gap-3">
      <%= link_to t("stories.status_page.read"), shared_episode_path(episode.share_token), class: "btn-primary", id: "read-story" %>
    </div>
  <% elsif story_request.failed? %>
    <p class="font-semibold text-red-800"><%= t("stories.status_page.failed") %></p>
    <p class="text-sm text-muted mt-1"><%= t("stories.status_page.failed_hint") %></p>
    <%= link_to t("stories.index.create"), new_story_path, class: "btn-secondary mt-3" %>
  <% else %>
    <p class="font-semibold text-ink-strong"><%= t("stories.status_page.generating") %></p>
    <ol class="mt-3 grid gap-1 text-sm">
      <% steps = StoryRequest::STEPS %>
      <% current = steps.index(story_request.step) %>
      <% steps.each_with_index do |step, index| %>
        <% state = current.nil? ? :todo : (index < current ? :done : (index == current ? :now : :todo)) %>
        <li class="flex items-center gap-2 <%= state == :todo ? "text-muted" : "text-ink-strong" %>" data-step="<%= step %>" data-state="<%= state %>">
          <span aria-hidden="true"><%= { done: "✓", now: "…", todo: "·" }[state] %></span>
          <%= t("stories.steps.#{step}") %>
        </li>
      <% end %>
    </ol>
    <p class="text-xs text-muted mt-3"><%= t("stories.status_page.wait_hint") %></p>
  <% end %>
</div>
