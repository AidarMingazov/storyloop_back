<% content_for :title, t("landing.#{@pair.code}.title") %>
<% content_for :wide, true %>
<section class="pt-2">
  <p class="font-serif text-2xl font-semibold text-ink-strong">Storyloop</p>
  <h1 class="font-serif text-[2.6rem] leading-[1.05] font-semibold text-ink-strong mt-8"><%= t("landing.#{@pair.code}.title") %></h1>
  <p class="mt-4 text-lg"><%= t("landing.#{@pair.code}.subtitle") %></p>
  <%= link_to t("landing.#{@pair.code}.cta"), start_path(pair: @pair.code), class: "btn-primary w-full h-14 text-base mt-7", id: "landing-cta" %>
  <p class="mt-2 text-center text-sm text-muted"><%= t("landing.#{@pair.code}.note") %></p>
</section>

<section class="mt-10 -mx-4 overflow-x-auto snap-x snap-mandatory px-4 pb-2" aria-label="Storyloop">
  <div class="flex gap-4 w-max">
    <% t("landing.#{@pair.code}.shots").each_with_index do |caption, index| %>
      <figure class="snap-center w-[15.5rem] shrink-0">
        <div class="overflow-hidden rounded-[1.75rem] border-[5px] border-ink-strong bg-panel shadow-sm aspect-[390/844]">
          <%= image_tag "landing/#{@pair.code}-#{index + 1}.webp", alt: caption, class: "w-full h-full object-cover object-top",
                        loading: index.zero? ? "eager" : "lazy", width: 390, height: 844 %>
        </div>
        <figcaption class="mt-3 text-sm font-semibold text-ink-strong"><%= caption %></figcaption>
      </figure>
    <% end %>
  </div>
</section>

<section class="mt-10">
  <%= link_to t("landing.#{@pair.code}.cta"), start_path(pair: @pair.code), class: "btn-primary w-full h-14 text-base" %>
</section>
