<% content_for :title, t("waitlist.title") %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong"><%= t("waitlist.title") %></h1>
<p class="mt-2 mb-6"><%= t("waitlist.body") %></p>

<%= form_with model: @entry, url: waitlist_entries_path, class: "card p-6 grid gap-5" do |form| %>
  <%= form_errors(@entry) %>
  <%= form.hidden_field :plan %>
  <div>
    <%= form.label :email, t("waitlist.email"), class: "label" %>
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "input" %>
  </div>
  <div><%= form.submit t("waitlist.submit"), class: "btn-primary w-full" %></div>
<% end %>
