<% content_for :title, @author.author_name %>
<header class="mb-5">
  <p class="label"><%= link_to t("stories.community.title"), community_path, class: "hover:text-ink-strong" %></p>
  <h1 class="font-serif text-4xl font-semibold text-ink-strong" id="author-name"><%= @author.author_name %></h1>
</header>

<% if @hidden %>
  <section class="card p-5" id="author-hidden">
    <p><%= t("stories.hide_author.hidden") %></p>
    <%= button_to t("stories.hide_author.undo"), author_block_path(@author.public_id), method: :delete, class: "btn-secondary mt-3" %>
  </section>
<% elsif @feed.items.empty? %>
  <p class="card p-6 text-center text-muted"><%= t("stories.community.author_empty") %></p>
<% else %>
  <div class="grid gap-3" id="author-stories">
    <%= render partial: "community/card", collection: @feed.items, as: :episode %>
  </div>
  <% if @feed.next_page? %>
    <%= link_to t("stories.community.more"), author_path(@author.public_id, page: @feed.page + 1), class: "btn-secondary mt-4" %>
  <% end %>
<% end %>

<% if @reader && @reader != @author && !@hidden %>
  <%= button_to t("stories.hide_author.button"), author_block_path(@author.public_id), class: "text-sm text-muted underline mt-6" %>
<% end %>
