<% content_for :title, "Восстановление пароля" %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong mb-6">Забыли пароль?</h1>

<%= form_with url: passwords_path, class: "card p-6 grid gap-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
  </div>
  <div><%= form.submit "Прислать ссылку", class: "btn-primary" %></div>
<% end %>
