<% content_for :title, t("auth.magic_link.title") %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong"><%= t("auth.magic_link.title") %></h1>

<% if params[:sent].present? %>
  <p class="flash-notice mt-6" id="notice" role="status"><%= t("auth.magic_link.sent", email: params[:sent]) %></p>
<% else %>
  <p class="mt-2 mb-6"><%= t("auth.magic_link.body") %></p>
  <%= form_with url: magic_link_path, class: "card p-6 grid gap-5" do |form| %>
    <div>
      <%= form.label :email_address, t("auth.email"), class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", class: "input" %>
    </div>
    <div><%= form.submit t("auth.magic_link.submit"), class: "btn-primary w-full" %></div>
  <% end %>
<% end %>
