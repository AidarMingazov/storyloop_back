<% content_for :title, "Privacy policy" %>
<article class="grid gap-4">
  <p class="flash-alert">Placeholder template. Replace with legally reviewed text before launch.</p>
  <h1 class="font-serif text-4xl font-semibold text-ink-strong">Privacy policy</h1>
