<% content_for :title, @episode.title %>
<main class="mx-auto max-w-xl px-4 pt-16 pb-12 text-center">
  <p class="text-sm text-muted"><%= @episode.series.title %> · <%= t("reader.episode", number: @episode.number) %></p>
  <h1 class="font-serif text-3xl font-semibold text-ink-strong mt-2"><%= t("reader.locked.title") %></h1>
  <p class="mt-3"><%= t("reader.locked.body") %></p>
  <%= link_to t("reader.locked.back"), root_path, class: "btn-primary mt-8" %>
</main>
