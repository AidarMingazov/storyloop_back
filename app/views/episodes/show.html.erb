<% content_for :title, "#{@episode.title} · #{@episode.series.title}" %>
<% pair = @episode.series.language_pair %>
<% use_fonts_for pair.target_lang %>
<% editions = reader_editions(@episode, @reader) %>
<%= render "episodes/og", episode: @episode %>
<div class="reader" data-format="<%= @episode.format %>" data-mode="read" data-controller="reader"
     data-reader-i18n-value="<%= t("reader.js").to_json %>"
     data-reader-progress-url-value="<%= episode_progress_path(@episode) %>"
     data-reader-save-url-value="<%= user_words_path %>"
     data-reader-review-url-value="<%= review_path %>"
     data-reader-library-url-value="<%= root_path %>"
     data-reader-signup-url-value="<%= new_registration_path %>"
     data-reader-episode-url-value="<%= episode_path("__ID__") %>">
  <script type="application/json" data-reader-target="payload"><%= json_escape(@payload.to_json).html_safe %></script>

  <header class="reader-header" data-reader-target="header" data-action="focusin->reader#revealChrome">
    <div class="reader-header-row">
      <%= link_to root_path, class: "reader-icon-btn", aria: { label: t("reader.back") } do %><%= icon(:back) %><% end %>
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold"><%= @episode.series.title %></p>
        <p class="truncate text-xs reader-muted"><%= t("reader.episode", number: @episode.number) %> · <%= @episode.title %></p>
      </div>
      <%= render "episodes/share_button", episode: @episode %>
      <%# The language pill: what is being read, and the way into the reading settings. %>
      <button type="button" class="reader-pill" data-action="reader#toggleSettings" data-reader-target="settingsButton"
              aria-label="<%= t("reader.settings") %>" aria-haspopup="dialog" aria-expanded="false" aria-controls="reader-settings">
        <span><%= pair.target_lang.upcase %> · <%= @episode.cefr_level %></span><%= icon(:chevron_down) %>
      </button>
    </div>
    <div class="reader-progress"><i data-reader-target="progressBar"></i></div>
  </header>

  <main class="reader-stage" data-reader-target="stage" lang="<%= pair.target_lang %>"
        data-action="click->reader#stageClick keydown->reader#stageKeydown"></main>

  <section class="reader-summary" data-reader-target="summary" hidden aria-live="polite"></section>

  <%= render "episodes/story_footer", episode: @episode %>

  <p class="reader-ai-notice"><%= t("reader.ai_notice") %></p>

  <aside class="word-sheet" data-reader-target="sheet" role="dialog" aria-modal="false" aria-hidden="true" tabindex="-1"></aside>

  <%# Reading settings: a bottom sheet from the language pill. Prefs are per device (reader/prefs.js). %>
  <aside id="reader-settings" class="sheet reader-settings" data-reader-target="settings" role="dialog" aria-modal="false"
         aria-labelledby="reader-settings-title" aria-hidden="true" tabindex="-1" inert>
    <i class="sheet-handle" aria-hidden="true"></i>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 class="reader-set-title" id="reader-settings-title"><%= t("reader.settings_sheet.title") %></h2>
        <p class="text-sm reader-muted"><%= language_name(pair.target_lang) %> · <%= @episode.cefr_level %></p>
      </div>
      <button type="button" class="btn-icon -mr-2" data-action="reader#closeSettings" aria-label="<%= t("reader.js.close") %>"><%= icon(:close) %></button>
    </div>

    <% if editions.many? %>
      <div class="reader-set-row" id="story-editions">
        <p class="reader-set-label"><%= t("reader.settings_sheet.story_language") %></p>
        <div class="flex flex-wrap gap-1.5">
          <% editions.each do |edition| %>
            <% current = edition == @episode %>
            <%= link_to language_name(edition.series.language_pair.target_lang), read_path(edition),
                        class: class_names("chip", "is-on": current), aria: { current: current ? "true" : nil } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div>
      <% if pair.target_lang == "ko" %><%= reader_switch :romanization, t("reader.js.romanization") %><% end %>
      <%= reader_switch :translations, t("reader.settings_sheet.translations") %>
      <%= reader_switch :highlight, t("reader.js.highlight_saved") %>
    </div>

    <%= reader_choice :size, t("reader.settings_sheet.text_size"),
                      { "s" => t("reader.settings_sheet.size_s"), "m" => t("reader.settings_sheet.size_m"), "l" => t("reader.settings_sheet.size_l") } %>
    <%= reader_choice :theme, t("reader.settings_sheet.appearance"),
                      { "auto" => t("reader.settings_sheet.theme_auto"), "light" => t("reader.settings_sheet.theme_light"), "night" => t("reader.settings_sheet.theme_night") } %>
    <% if @episode.format == "manga" %>
      <%= reader_choice :page_turn, t("reader.js.page_turn"), %w[slide curl none].index_with { |effect| t("reader.js.page_turn_#{effect}") } %>
    <% end %>
  </aside>
</div>
