<% content_for :title, t("stories.unavailable.title") %>
<section class="card p-6 text-center" id="story-unavailable">
  <h1 class="font-serif text-3xl font-semibold text-ink-strong"><%= t("stories.unavailable.title") %></h1>
  <p class="mt-2 text-muted"><%= t("stories.unavailable.body") %></p>
  <div class="mt-5 flex flex-wrap justify-center gap-3">
    <%= link_to t("stories.unavailable.community"), community_path, class: "btn-primary" %>
    <%= link_to t("stories.unavailable.home"), root_path, class: "btn-secondary" %>
  </div>
</section>
