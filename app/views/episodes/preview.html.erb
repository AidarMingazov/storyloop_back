<%# What messenger crawlers get for a share link: the OG tags and a plain card, no reader. %>
<% content_for :title, story_title(@episode) %>
<%= render "episodes/og", episode: @episode %>
<article class="card p-5">
  <p class="label"><%= pair_label(@episode.series.language_pair) %> · <%= @episode.cefr_level %></p>
  <h1 class="font-serif text-3xl font-semibold text-ink-strong"><%= @episode.title %></h1>
  <p class="text-muted mt-1"><%= @episode.series.title %></p>
  <% if @episode.synopsis.present? %><p class="mt-3"><%= @episode.synopsis %></p><% end %>
  <%= link_to t("stories.preview.read"), shared_episode_path(@episode.share_token), class: "btn-primary mt-4" %>
</article>
