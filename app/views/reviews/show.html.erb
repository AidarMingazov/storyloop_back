<% content_for :title, t("reader.review.title") %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong mb-2"><%= t("reader.review.title") %></h1>
<p class="text-muted mb-6"><%= t("reader.review.soon") %></p>
<% if @words.empty? %>
  <p class="card p-6"><%= t("reader.review.empty") %></p>
<% else %>
  <ul class="grid gap-3">
    <% @words.each do |word| %>
      <li class="card p-4">
        <p class="font-serif text-xl font-semibold text-ink-strong"><span class="marker"><%= word.lexeme.lemma %></span>
          <% if word.lexeme.romanization %><span class="text-sm font-sans font-normal text-muted"><%= word.lexeme.romanization %></span><% end %></p>
        <p class="mt-1"><%= word.lexeme.translations.values.first %></p>
        <% if word.source_token %><p class="text-sm text-muted mt-1 font-serif"><%= word.source_token.bubble.text %></p><% end %>
      </li>
    <% end %>
  </ul>
<% end %>
<%= link_to t("reader.locked.back"), root_path, class: "btn-secondary mt-8" %>
