<% series = episode.series %>
<% panel = episode.panels.find { |p| p.image.attached? } %>
<article class="card overflow-hidden" id="<%= dom_id(episode, :card) %>">
  <%= link_to read_path(episode), class: "flex gap-4 p-4 hover:bg-recess" do %>
    <% if panel %>
      <%= image_tag panel.image.variant(:phone), alt: "", loading: "lazy", class: "size-20 shrink-0 rounded-xl object-cover" %>
    <% else %>
      <span class="size-20 shrink-0 rounded-xl bg-recess flex items-center justify-center text-2xl" aria-hidden="true"><%= theme_icon(series.genre) || "📖" %></span>
    <% end %>
    <span class="min-w-0">
      <span class="block font-serif text-xl font-semibold text-ink-strong line-clamp-2"><%= series.title %></span>
      <span class="block text-sm text-muted"><%= pair_label(series.language_pair) %> · <%= episode.cefr_level %></span>
      <span class="block text-xs text-muted mt-1"><%= series.author.author_name %> · <%= t("stories.index.reads", count: episode.reads_count) %></span>
    </span>
  <% end %>
</article>
