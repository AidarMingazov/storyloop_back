<%= form_with model: [ :admin, series ], class: "card p-6 grid gap-5 max-w-2xl" do |f| %>
  <%= form_errors(series) %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :language_pair_id, "Пара", class: "label" %>
      <%= f.collection_select :language_pair_id, LanguagePair.order(:code), :id, :code, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :slug, "Slug", class: "label" %>
      <%= f.text_field :slug, class: "input", required: true, pattern: "[a-z0-9-]+" %>
    </div>
  </div>
  <div>
    <%= f.label :title, "Название", class: "label" %>
    <%= f.text_field :title, class: "input", required: true %>
  </div>
  <div>
    <%= f.label :description, "Описание (на языке подсказок)", class: "label" %>
    <%= f.text_area :description, rows: 3, class: "input" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-4">
    <div class="sm:col-span-2">
      <%= f.label :genre, "Жанр", class: "label" %>
      <%= f.text_field :genre, class: "input" %>
    </div>
    <div>
      <%= f.label :cefr_level, "Уровень", class: "label" %>
      <%= f.select :cefr_level, Cefr::LEVELS, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :status, "Статус", class: "label" %>
      <%= f.select :status, Series.statuses.keys, {}, class: "input" %>
    </div>
  </div>
  <div>
    <%= f.label :tone, "Тон историй (для сценария)", class: "label" %>
    <%= f.text_area :tone, rows: 2, class: "input" %>
  </div>
  <div>
    <%= f.label :art_style, "Стиль рисовки (для листов персонажей, без мест и света)", class: "label" %>
    <%= f.text_area :art_style, rows: 2, class: "input" %>
  </div>
  <div>
    <%= f.label :style_prompt, "Стиль картинок (для кадров)", class: "label" %>
    <%= f.text_area :style_prompt, rows: 3, class: "input" %>
  </div>
  <div>
    <%= f.label :narrator_voice, "Голос рассказчика TTS", class: "label" %>
    <%= f.text_field :narrator_voice, class: "input" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :position, "Порядок в библиотеке", class: "label" %>
      <%= f.number_field :position, class: "input" %>
    </div>
    <div>
      <%= f.label :cover, "Обложка", class: "label" %>
      <%= f.file_field :cover, accept: "image/*", class: "input" %>
    </div>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Сохранить", class: "btn-primary" %>
    <%= link_to "Отмена", series.persisted? ? admin_series_path(series) : admin_series_index_path, class: "btn-secondary" %>
  </div>
<% end %>
