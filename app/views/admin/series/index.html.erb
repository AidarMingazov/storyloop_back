<% content_for :title, "Серии" %>
<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
  <div>
    <h1 class="font-serif text-4xl font-semibold text-ink-strong">Серии</h1>
    <p class="text-muted mt-1">Истории по языковым парам. Эпизоды проверяются здесь перед публикацией.</p>
  </div>
  <div class="flex gap-2">
    <%= link_to "Импорт JSON", new_admin_import_path, class: "btn-secondary" %>
    <%= link_to "Новая серия", new_admin_series_path, class: "btn-primary" %>
  </div>
</div>

<section class="card p-4 mb-6 flex flex-wrap items-center gap-3" id="templates">
  <h2 class="label mb-0">Шаблоны для AI-конвейера</h2>
  <% @templates.each do |name| %>
    <%= button_to name, load_template_admin_series_index_path(name:), class: "btn-secondary btn-sm",
          form: { data: { turbo_confirm: "Загрузить шаблон #{name}? Серия и персонажи обновятся из файла." } } %>
  <% end %>
</section>

<% if @series.empty? %>
  <div class="card p-8 text-center text-muted">
    Серий пока нет. Загрузите сиды: <code class="text-ink-strong">docker compose run --rm web bin/rails db:seed</code>
  </div>
<% else %>
  <div class="card overflow-x-auto">
    <table class="table">
      <thead>
        <tr><th>Пара</th><th>Серия</th><th>Уровень</th><th>Эпизоды</th><th>Статус</th></tr>
      </thead>
      <tbody>
        <% @series.each do |series| %>
          <tr>
            <td><span class="badge"><%= series.language_pair.code %></span></td>
            <td>
              <%= link_to series.title, admin_series_path(series), class: "font-semibold text-ink-strong hover:underline" %>
              <div class="text-xs text-muted"><%= series.genre %></div>
            </td>
            <td><%= series.cefr_level %></td>
            <td class="tabular-nums">
              <%= series.episodes.count(&:published?) %> / <%= series.episodes.size %> опубл.
            </td>
            <td><%= status_badge(series) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
