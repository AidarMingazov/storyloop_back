<% content_for :title, @series.title %>
<div class="flex flex-wrap items-start justify-between gap-4 mb-8">
  <div class="min-w-0">
    <p class="text-sm text-muted"><%= link_to "Серии", admin_series_index_path, class: "hover:underline" %> · <%= @series.language_pair.code %> · <%= @series.cefr_level %> · <%= @series.genre %></p>
    <h1 class="font-serif text-4xl font-semibold text-ink-strong mt-1"><%= @series.title %></h1>
    <p class="mt-2 max-w-2xl"><%= @series.description %></p>
  </div>
  <div class="flex gap-2">
    <%= status_badge(@series) %>
    <%= link_to "Изменить", edit_admin_series_path(@series), class: "btn-secondary btn-sm" %>
  </div>
</div>

<div class="grid gap-8 lg:grid-cols-[2fr_1fr]">
  <section class="min-w-0">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-serif text-2xl font-semibold text-ink-strong">Эпизоды</h2>
      <%= link_to "Новый эпизод", new_admin_series_episode_path(@series), class: "btn-secondary btn-sm" %>
    </div>
    <div class="card overflow-x-auto">
      <table class="table">
        <thead><tr><th>#</th><th>Название</th><th>Формат</th><th>Кадры</th><th>Доступ</th><th>Статус</th></tr></thead>
        <tbody>
          <% @episodes.each do |episode| %>
            <tr>
              <td class="tabular-nums"><%= episode.number %></td>
              <td><%= link_to episode.title, admin_episode_path(episode), class: "font-semibold text-ink-strong hover:underline" %></td>
              <td><%= episode.format %></td>
              <td class="tabular-nums"><%= episode.panels.size %></td>
              <td><%= episode.free? ? "бесплатно" : "пейвол" %></td>
              <td><%= status_badge(episode) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-serif text-2xl font-semibold text-ink-strong">Персонажи</h2>
      <%= link_to "Добавить", new_admin_series_character_path(@series), class: "btn-secondary btn-sm" %>
    </div>
    <ul class="grid gap-3">
      <% @series.characters.each do |character| %>
        <li class="card p-4">
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-ink-strong"><%= character.name %></span>
            <%= link_to "Изменить", edit_admin_character_path(character), class: "text-sm text-link hover:underline" %>
          </div>
          <p class="text-xs text-muted mt-0.5"><%= character.key %><%= " · главный герой" if character.protagonist? %><%= " · голос #{character.voice}" if character.voice.present? %><%= " · #{Character::SPEECH_LEVEL_NAMES[character.speech_level]}" if character.speech_level %></p>
          <% if character.sheet.attached? %>
            <%= image_tag url_for(character.sheet), alt: "Лист персонажа #{character.name}", class: "mt-2 w-full rounded border border-edge" %>
          <% else %>
            <p class="text-xs text-muted mt-2">нет листа персонажа</p>
          <% end %>
          <p class="text-sm mt-2 line-clamp-3"><%= character.appearance_prompt %></p>
        </li>
      <% end %>
    </ul>
    <% { "Тон историй" => @series.tone, "Стиль рисовки" => @series.art_style, "Стиль картинок" => @series.style_prompt,
         "Голос рассказчика" => @series.narrator_voice }.compact_blank.each do |label, text| %>
      <h3 class="label mt-6"><%= label %></h3>
      <p class="text-sm"><%= text %></p>
    <% end %>
  </section>
</div>
