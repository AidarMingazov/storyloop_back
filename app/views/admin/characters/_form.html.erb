<%= form_with model: character.persisted? ? [ :admin, character ] : [ :admin, character.series, character ], class: "card p-6 grid gap-5 max-w-2xl" do |f| %>
  <%= form_errors(character) %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :name, "Имя", class: "label" %>
      <%= f.text_field :name, class: "input", required: true %>
    </div>
    <div>
      <%= f.label :key, "Ключ (в JSON)", class: "label" %>
      <%= f.text_field :key, class: "input", required: true, pattern: "[a-z0-9_]+" %>
    </div>
  </div>
  <div>
    <%= f.label :appearance_prompt, "Внешность (промпт для картинок)", class: "label" %>
    <%= f.text_area :appearance_prompt, rows: 4, class: "input" %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :voice, "Голос TTS", class: "label" %>
      <%= f.text_field :voice, class: "input" %>
    </div>
    <div>
      <%= f.label :speech_level, "Уровень вежливости", class: "label" %>
      <%= f.select :speech_level, Character::SPEECH_LEVEL_NAMES.map { |level, name| [ "#{name} · #{level}", level ] },
            { include_blank: "по ситуации" }, class: "input" %>
    </div>
  </div>
  <label class="flex items-center gap-2">
    <%= f.check_box :protagonist, class: "size-4" %> Главный герой (справа в чате)
  </label>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :avatar, "Аватар", class: "label" %>
      <%= f.file_field :avatar, accept: "image/*", class: "input" %>
    </div>
    <div>
      <%= f.label :reference_images, "Референсы", class: "label" %>
      <%= f.file_field :reference_images, multiple: true, accept: "image/*", class: "input" %>
    </div>
  </div>
  <div>
    <%= f.label :sheet, "Лист персонажа (свой файл вместо генерации)", class: "label" %>
    <%= f.file_field :sheet, accept: "image/*", class: "input" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Сохранить", class: "btn-primary" %>
    <%= link_to "Отмена", admin_series_path(character.series), class: "btn-secondary" %>
  </div>
<% end %>
