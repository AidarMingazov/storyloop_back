<%= form_with model: episode.persisted? ? [ :admin, episode ] : [ :admin, episode.series, episode ], class: "card p-6 grid gap-5 max-w-2xl" do |f| %>
  <%= form_errors(episode) %>
  <div class="grid gap-5 sm:grid-cols-4">
    <div>
      <%= f.label :number, "Номер", class: "label" %>
      <%= f.number_field :number, class: "input", min: 1, required: true %>
    </div>
    <div class="sm:col-span-3">
      <%= f.label :title, "Название", class: "label" %>
      <%= f.text_field :title, class: "input", required: true %>
    </div>
  </div>
  <div class="grid gap-5 sm:grid-cols-4">
    <div>
      <%= f.label :format, "Формат", class: "label" %>
      <%= f.select :format, Episode::FORMATS, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :cefr_level, "Уровень", class: "label" %>
      <%= f.select :cefr_level, Cefr::LEVELS, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :status, "Статус", class: "label" %>
      <%= f.select :status, Episode.statuses.keys, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :estimated_minutes, "Минут", class: "label" %>
      <%= f.number_field :estimated_minutes, class: "input", min: 1 %>
    </div>
  </div>
  <label class="flex items-center gap-2"><%= f.check_box :free, class: "size-4" %> Бесплатный (до пейвола)</label>
  <div>
    <%= f.label :synopsis, "Краткое содержание (контекст для следующих эпизодов)", class: "label" %>
    <%= f.text_area :synopsis, rows: 3, class: "input" %>
  </div>
  <div>
    <%= f.label :target_words_text, "Целевые слова (через запятую)", class: "label" %>
    <%= f.text_area :target_words_text, value: episode.target_words.join(", "), rows: 2, class: "input" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Сохранить", class: "btn-primary" %>
    <%= link_to "Отмена", episode.persisted? ? admin_episode_path(episode) : admin_series_path(episode.series), class: "btn-secondary" %>
  </div>
<% end %>
