<% content_for :title, "Кадр #{@panel.position + 1}" %>
<p class="text-sm text-muted"><%= link_to "##{@panel.episode.number} #{@panel.episode.title}", admin_episode_path(@panel.episode, anchor: dom_id(@panel)), class: "hover:underline" %></p>
<h1 class="font-serif text-4xl font-semibold text-ink-strong mt-1 mb-6">Кадр <%= @panel.position + 1 %></h1>
<%= form_with model: [ :admin, @panel ], class: "card p-6 grid gap-5 max-w-2xl" do |f| %>
  <%= form_errors(@panel) %>
  <div>
    <%= f.label :image_prompt, "Промпт сцены (без текста и пузырей)", class: "label" %>
    <%= f.text_area :image_prompt, rows: 5, class: "input" %>
  </div>
  <div>
    <%= f.label :layout_json, "Layout (JSON)", class: "label" %>
    <%= f.text_area :layout_json, value: JSON.pretty_generate(@panel.layout), rows: 4, class: "input font-mono text-sm" %>
    <p class="text-xs text-muted mt-1">aspect_ratio — ширина / высота картинки, по умолчанию 0.8</p>
  </div>
  <div>
    <%= f.label :image, "Картинка", class: "label" %>
    <% if @panel.image.attached? %><%= image_tag @panel.image, class: "w-40 rounded-lg mb-2" %><% end %>
    <%= f.file_field :image, accept: "image/*", class: "input" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Сохранить", class: "btn-primary" %>
    <%= link_to "Отмена", admin_episode_path(@panel.episode, anchor: dom_id(@panel)), class: "btn-secondary" %>
  </div>
<% end %>
