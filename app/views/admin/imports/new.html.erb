<% content_for :title, "Импорт JSON" %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong mb-2">Импорт эпизода</h1>
<p class="text-muted mb-6 max-w-2xl">
  Формат — <code class="text-ink-strong">config/schemas/episode.json</code>, тот же, что выдаёт шаг «Сценарий» конвейера.
  Повторный импорт серии с тем же slug и номером эпизода заменяет кадры. Позиции токенов можно не указывать.
</p>
<% if @errors.present? %>
  <div class="flash-alert mb-6 max-w-3xl" role="alert">
    <p class="font-semibold mb-1">JSON не прошёл проверку:</p>
    <ul class="list-disc pl-5 font-mono text-xs"><% @errors.first(30).each do |e| %><li><%= e %></li><% end %></ul>
  </div>
<% end %>
<%= form_with url: admin_imports_path, multipart: true, class: "card p-6 grid gap-5 max-w-3xl" do |f| %>
  <div>
    <%= f.label :file, "Файл .json", class: "label" %>
    <%= f.file_field :file, accept: "application/json,.json", class: "input" %>
  </div>
  <div>
    <%= f.label :json, "или вставьте JSON", class: "label" %>
    <%= f.text_area :json, value: @json, rows: 12, class: "input font-mono text-xs" %>
  </div>
  <label class="flex items-center gap-2"><%= f.check_box :publish, {}, "1", "0" %> Сразу опубликовать (иначе — на проверку)</label>
  <div><%= f.submit "Импортировать", class: "btn-primary" %></div>
<% end %>
