<% content_for :title, "Пузырь" %>
<p class="text-sm text-muted"><%= link_to "##{@bubble.episode.number} #{@bubble.episode.title}, кадр #{@bubble.panel.position + 1}", admin_episode_path(@bubble.episode, anchor: dom_id(@bubble.panel)), class: "hover:underline" %></p>
<h1 class="font-serif text-4xl font-semibold text-ink-strong mt-1 mb-6">Пузырь</h1>
<%= form_with model: [ :admin, @bubble ], class: "card p-6 grid gap-5 max-w-2xl" do |f| %>
  <%= form_errors(@bubble) %>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :kind, "Тип", class: "label" %>
      <%= f.select :kind, Bubble::KINDS, {}, class: "input" %>
    </div>
    <div>
      <%= f.label :character_id, "Говорящий", class: "label" %>
      <%= f.collection_select :character_id, @bubble.episode.series.characters, :id, :name, { include_blank: "— (рассказчик)" }, class: "input" %>
    </div>
  </div>
  <div>
    <%= f.label :text, "Текст", class: "label" %>
    <%= f.text_area :text, rows: 3, class: "input font-serif text-lg" %>
    <p class="text-xs text-muted mt-1">Если меняете текст, проверьте токены: их позиции должны совпадать с новым текстом.</p>
  </div>
  <div>
    <%= f.label :translation, "Перевод фразы", class: "label" %>
    <%= f.text_area :translation, rows: 2, class: "input" %>
  </div>
  <fieldset>
    <legend class="label">Позиция на картинке, % от кадра</legend>
    <div class="grid gap-3 grid-cols-4">
      <% { "x" => "Слева", "y" => "Сверху", "w" => "Ширина", "h" => "Высота" }.each do |key, label| %>
        <label class="text-sm">
          <%= label %>
          <%= number_field_tag "bubble[box][#{key}]", @bubble.box&.fetch(key, nil), min: 0, max: 100, step: 0.5,
                class: "input tabular-nums", id: "bubble_box_#{key}" %>
        </label>
      <% end %>
    </div>
    <p class="text-xs text-muted mt-1">Все поля пустые — пузырь расставит шаг «Пузыри».</p>
  </fieldset>
  <div>
    <%= f.label :audio, "Озвучка реплики", class: "label" %>
    <% if @bubble.audio.attached? %><audio controls preload="none" src="<%= url_for(@bubble.audio) %>" class="mb-2 w-full"></audio><% end %>
    <%= f.file_field :audio, accept: "audio/*", class: "input" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit "Сохранить", class: "btn-primary" %>
    <%= link_to "Отмена", admin_episode_path(@bubble.episode, anchor: dom_id(@bubble.panel)), class: "btn-secondary" %>
  </div>
<% end %>
