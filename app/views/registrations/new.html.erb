<% content_for :title, t("auth.registration.title") %>
<h1 class="font-serif text-4xl font-semibold text-ink-strong"><%= t("auth.registration.title") %></h1>
<p class="mt-2 mb-6"><%= t("auth.registration.body") %></p>

<% if @errors.present? %>
  <div class="flash-alert mb-6" role="alert"><ul class="list-disc pl-5"><% @errors.each do |e| %><li><%= e %></li><% end %></ul></div>
<% end %>

<%= form_with url: registration_path, class: "card p-6 grid gap-5" do |form| %>
  <div>
    <%= form.label :email_address, t("auth.email"), class: "label" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", value: params[:email_address], class: "input" %>
  </div>
  <div>
    <%= form.label :password, t("auth.password"), class: "label" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input",
                            aria: { describedby: "password-hint" } %>
    <p id="password-hint" class="text-xs text-muted mt-1"><%= t("auth.registration.password_hint") %></p>
  </div>
  <div><%= form.submit t("auth.registration.submit"), class: "btn-primary w-full" %></div>
<% end %>

<div class="mt-6 grid gap-3 text-sm">
  <%= link_to t("auth.registration.or_magic"), new_magic_link_path, class: "btn-secondary w-full" %>
  <p class="text-center text-muted"><%= t("auth.registration.have_account") %> <%= link_to t("auth.registration.sign_in"), new_session_path, class: "underline text-ink-strong" %></p>
</div>
