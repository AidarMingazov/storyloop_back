# Copy the lines you need into storyloop_back/.env (gitignored: /.env*). Never commit real keys.
# In wave 6.1 these move to `bin/rails credentials:edit` under `ai:`.

# DeepSeek — https://platform.deepseek.com → API keys (top up balance first)
DEEPSEEK_API_KEY=

# Qwen — Alibaba Cloud Model Studio, region Singapore (international) → API Key.
# Keys are region-bound. If the default endpoint gives 401, set the workspace URL from the console:
# QWEN_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# Seedream — BytePlus ModelArk (console.byteplus.com → ModelArk) → API Key; enable the Seedream model
# in "Model activation" and copy its exact model id here:
ARK_API_KEY=
SEEDREAM_MODEL=seedream-4-5-251128

# MiniMax — https://platform.minimax.io (international) → API Keys
MINIMAX_API_KEY=

# Optional
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
